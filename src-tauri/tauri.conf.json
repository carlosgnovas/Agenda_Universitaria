{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agenda Universitaria",
  "version": "1.0.0",
  "identifier": "app.agendauniversitaria.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Agenda Universitaria", "width": 1320, "height": 860, "minWidth": 970, "minHeight": 630, "backgroundColor": "#0c111b" }], "security": { "csp": "default-src 'self'; connect-src 'self' https: wss: ws: http://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;" } },
  "bundle": { "active": true, "targets": ["deb", "nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"], "shortDescription": "Agenda académica y gestión de calificaciones" }
}
